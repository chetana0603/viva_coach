# Copy this file to .env and fill it in. NEVER commit .env — it holds real secrets.
#
#   copy .env.example .env

FLASK_ENV=development

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Supabase: dashboard -> Connect -> "Transaction pooler" string, then
#   1. change  postgresql://  to  postgresql+psycopg://
#   2. replace [YOUR-PASSWORD] with your real database password
# The host must contain "pooler.supabase.com" and the port is 6543.
#
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# Leave this line commented out entirely to use a local SQLite file instead
# (fine for a first look; not for the real study).
# DATABASE_URL=

# --- Question generation ----------------------------------------------------
# From console.groq.com. Needed only for generating questions, never during a test.
GROQ_API_KEY=

# --- Optional ---------------------------------------------------------------
# Restrict registration to one email domain, e.g. college.edu (no @).
# Leave blank while testing or every address is rejected.
ALLOWED_EMAIL_DOMAIN=
